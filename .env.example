# Kopieren nach .env und Werte eintragen:  cp .env.example .env
# Secrets erzeugen mit:  openssl rand -base64 32   (bzw. -hex 32 für den 2FA-Key)

# Domain, unter der Umami erreichbar ist (A-Record muss auf den Server zeigen)
UMAMI_DOMAIN=analytics.leonardogranetto.com

# Postgres-Passwort (openssl rand -base64 32)
DB_PASSWORD=

# Umami-App-Secret für Auth-Tokens (openssl rand -base64 32)
APP_SECRET=

# Optional: 64-Zeichen-Hex-Key, nur nötig wenn du 2FA aktivieren willst (openssl rand -hex 32)
TWO_FACTOR_ENCRYPTION_KEY=

# Optional: neutraler Tracker-Script-Name gegen Adblocker.
# "stats" → Script liegt dann unter https://<UMAMI_DOMAIN>/stats.js
# Leer lassen = Standardname "script.js"
TRACKER_SCRIPT_NAME=stats
